<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>ScreenshotMaker</RootNamespace>
    <AssemblyName>ScreenshotMaker</AssemblyName>

    <Version>2.0.0</Version>
    <Product>Screenshot Maker</Product>
    <Description>Automatically saves every screenshot you take to a folder.</Description>
    <Copyright>Copyright © 2023-2026 radimbig</Copyright>

    <!-- Application.SetColorMode (dark mode) is still marked experimental in WinForms. -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="ScreenshotMaker.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
